{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend-web install",
  "buildCommand": "npm --prefix frontend-web run build",
  "outputDirectory": "frontend-web/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1?route=$1"
    },
    {
      "source": "/((?!api/|downloads/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"HADIR-Android.apk\"" }
      ]
    }
  ]
}
